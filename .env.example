# --- Firebase / Firestore ---
# Option A (local dev): path to the service-account JSON downloaded from
#   Firebase Console > Project settings > Service accounts > Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Option B (GitHub Actions / Cloud Run secrets): the same JSON, base64-encoded, in one env var
#   base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=your-project-id

# --- Security ---
CRON_TOKEN=change-me-long-random-string   # header X-Cron-Token for cron-job.org / GitHub Actions
API_TOKEN=change-me-too                   # header X-API-Token for manual endpoints (empty = open)

# --- Reddit (https://www.reddit.com/prefs/apps -> "script" app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=validazione-startup/0.1 by u/your_username

# --- Product Hunt (https://www.producthunt.com/v2/oauth/applications -> developer token) ---
PRODUCTHUNT_TOKEN=

# --- Email notifications (choose one provider) ---
EMAIL_PROVIDER=smtp            # smtp | resend | none
NOTIFY_EMAIL_TO=giovannighigliotti96@gmail.com
NOTIFY_EMAIL_FROM=giovannighigliotti96@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=giovannighigliotti96@gmail.com
SMTP_PASSWORD=                 # Gmail "App password" (requires 2FA on the account)
RESEND_API_KEY=

# --- Scraper toggles / limits ---
ENABLE_INDIEHACKERS=false      # best-effort HTML scraper, fragile
ENABLE_TRUSTPILOT=false        # ToS-hostile, low frequency only
ENABLE_TRENDS=true             # pytrends is unofficial and rate-limited
REDDIT_POST_LIMIT=100
REDDIT_COMMENTS_PER_POST=20
HN_HITS_PER_QUERY=200
STORE_REVIEW_LIMIT=200
LOOKBACK_DAYS=180
REQUEST_DELAY_SECONDS=1.5

# --- cron-job.org (jobs created via API, see README) ---
CRONJOB_API_KEY=

# --- Public base url (used in emails) ---
PUBLIC_BASE_URL=https://your-service-xxxx-ew.a.run.app

# --- LLM layer (fase 2) — any OpenAI-compatible provider. No credit card needed for:
#   Mistral (recommended): https://console.mistral.ai/api-keys   base_url=https://api.mistral.ai/v1   model=ministral-8b-latest
#   Groq:                  https://console.groq.com/keys        base_url=https://api.groq.com/openai/v1  model=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=ministral-8b-latest        # free tier currently allows ministral-8b; mistral-small/medium return 429
LLM_MAX_CALLS_PER_RUN=400
LLM_RPM=50                       # Mistral free: 1 req/s. Groq free: 30/min -> set 25
LLM_BATCH_SIZE=25                # signals per extraction call
# Optional web search for market sizing / competitors (free 1000/month): https://app.tavily.com
META_PIXEL_ID=
YOUTUBE_API_KEY=
TAVILY_API_KEY=
# --- Strong model tier (few calls: enrichment, competitors, market, founder fit, discovery). Groq free: https://console.groq.com/keys
LLM_STRONG_BASE_URL=https://api.groq.com/openai/v1
LLM_STRONG_API_KEY=
LLM_STRONG_MODEL=openai/gpt-oss-120b
LLM_STRONG_RPM=20
