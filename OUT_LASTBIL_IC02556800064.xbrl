  <itcc-ci:IntroduzionePatrimonioNetto contextRef="I_20251231">&lt;body style="font-family:'Arial';font-size:12pt;background-color:#FFFFFF;text-align:left;"&gt;
&lt;p lang="it-IT" style="text-indent:0pt;margin-top:0pt;margin-bottom:0pt;line-height:150%;"&gt;&lt;span style="font-size:10pt;color:#000000;"&gt;Il patrimonio netto esistente alla chiusura dell&amp;#x0027;esercizio è pari a € &lt;/span&gt;&lt;span style="font-size:10pt;"&gt;204.652&lt;/span&gt;&lt;span style="font-size:10pt;"&gt; &lt;/span&gt;&lt;span style="font-size:10pt;color:#000000;"&gt;(€ &lt;/span&gt;&lt;span style="font-size:10pt;"&gt;275.596&lt;/span&gt;&lt;span style="font-size:10pt;"&gt; &lt;/span&gt;&lt;span style="font-size:10pt;color:#000000;"&gt;nel precedente esercizio).&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;</itcc-ci:IntroduzionePatrimonioNetto>
